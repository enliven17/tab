// Run the tests with `fe test`.
//
// The test account acts as the merchant. The payer is a contract wallet that
// approves digests on chain (ERC-1271), so no private key is needed.

use core::abi::store_word
use core::option::Option
use core::ptr::{self, MemBuffer}
use ingot::{NAME_HASH, Tab, TabMsg, VERSION_HASH, authorization_hash}
use ingot::demo_token::{DemoToken, TokenMsg}
use std::abi::Bytes32
use std::evm::{eip712, signature}

const GAS: u256 = 1_000_000
const LIMIT: u256 = 100
const MAGIC_WORD: u256 = 0x1626ba7e << 224
const NEVER: u256 = 0xffffffffffff

msg WalletMsg {
    #[selector = sol("isValidSignature(bytes32,bytes)")]
    IsValidSignature { hash: Bytes32, signature: Bytes } -> u256,
    #[selector = sol("sign(uint256)")]
    Sign { digest: u256 },
    #[selector = sol("approve(address,address,uint256)")]
    Approve { token: Address, spender: Address, amount: u256 },
}

/// A payer wallet that accepts the digests it was told to sign.
pub contract Wallet uses (call: mut Call) {
    mut signed: StorageMap<u256, bool>,

    recv WalletMsg {
        IsValidSignature { hash, signature } -> u256
        uses (signed)
        {
            if signed.get(key: hash.val) {
                return MAGIC_WORD
            }
            let rejected: u256 = 0
            rejected
        }

        Sign { digest } uses (mut signed) {
            signed.set(key: digest, value: true)
        }

        Approve { token, spender, amount } uses (mut call) {
            let ok: bool = call
                .call(
                    addr: token,
                    gas: GAS,
                    value: Wei::zero(),
                    message: TokenMsg::Approve { spender, amount },
                )
            assert!(ok)
        }
    }
}

msg StrangerMsg {
    #[selector = sol("charge(address,uint256,uint256)")]
    Charge { tab: Address, id: u256, amount: u256 },
}

/// Any account other than the merchant.
pub contract Stranger uses (call: mut Call) {
    recv StrangerMsg {
        Charge { tab, id, amount } uses (mut call) {
            call.call(
                addr: tab,
                gas: GAS,
                value: Wei::zero(),
                message: TabMsg::Charge { id, amount },
            )
        }
    }
}

struct World { token: Address, tab: Address, wallet: Address }

impl Copy for World {}

/// Deploys everything and funds the wallet with `LIMIT` tokens, approved for
/// the tab contract.
fn world() -> World uses (evm: mut Evm) {
    let token = evm.create2<DemoToken>(value: Wei::zero(), args: (), salt: 0)
    let tab = evm.create2<Tab>(value: Wei::zero(), args: (), salt: 0)
    let wallet = evm.create2<Wallet>(value: Wei::zero(), args: (), salt: 0)
    evm.call(
        addr: token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::Mint { to: wallet, amount: LIMIT },
    )
    evm.call(
        addr: wallet,
        gas: GAS,
        value: Wei::zero(),
        message: WalletMsg::Approve { token, spender: tab, amount: LIMIT },
    )
    World { token, tab, wallet }
}

/// Has the wallet sign an authorization for `signed_limit`, then opens a tab
/// for `limit` with the test account as merchant.
fn open(w: World, signed_limit: u256, limit: u256, capture_by: u256) -> u256
uses (evm: mut Evm)
{
    let merchant = evm.address()
    let open_by = Timestamp::from_seconds(NEVER)
    let capture_by = Timestamp::from_seconds(capture_by)
    let digest: u256 = evm
        .call(
            addr: w.tab,
            gas: GAS,
            value: Wei::zero(),
            message: TabMsg::Digest {
                payer: w.wallet,
                merchant,
                token: w.token,
                limit: signed_limit,
                open_by,
                capture_by,
                nonce: 1,
            },
        )
    evm.call(
        addr: w.wallet,
        gas: GAS,
        value: Wei::zero(),
        message: WalletMsg::Sign { digest },
    )
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Open {
            payer: w.wallet,
            merchant,
            token: w.token,
            limit,
            open_by,
            capture_by,
            nonce: 1,
            signature: Bytes::empty(),
        },
    )
}

fn balance(w: World, account: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: w.token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::BalanceOf { account },
    )
}

fn held(w: World, id: u256) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Held { id },
    )
}

fn charge(w: World, id: u256, amount: u256) uses (evm: mut Evm) {
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Charge { id, amount },
    )
}

#[test]
fn open_moves_the_limit_into_escrow() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    assert!(held(w, id) == LIMIT)
    assert!(balance(w, account: w.tab) == LIMIT)
    assert!(balance(w, account: w.wallet) == 0)
}

#[test]
fn charge_in_parts_then_close() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)

    charge(w, id, amount: 30)
    charge(w, id, amount: 20)
    assert!(balance(w, account: evm.address()) == 50)
    assert!(held(w, id) == 50)

    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Close { id },
    )
    assert!(held(w, id) == 0)
    assert!(balance(w, account: w.wallet) == 50)
    assert!(balance(w, account: w.tab) == 0)
}

#[test]
fn refund_returns_charged_funds() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    charge(w, id, amount: 60)

    let _: bool = evm
        .call(
            addr: w.token,
            gas: GAS,
            value: Wei::zero(),
            message: TokenMsg::Approve { spender: w.tab, amount: 25 },
        )
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Refund { id, amount: 25 },
    )
    assert!(balance(w, account: w.wallet) == 25)
    assert!(balance(w, account: evm.address()) == 35)
    let refunded: u256 = evm
        .call(
            addr: w.tab,
            gas: GAS,
            value: Wei::zero(),
            message: TabMsg::Refunded { id },
        )
    assert!(refunded == 25)
}

#[test]
fn reclaim_after_the_capture_window() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: 0)
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Reclaim { id },
    )
    assert!(balance(w, account: w.wallet) == LIMIT)
    assert!(held(w, id) == 0)
}

// cast sig "NotExpired()"
#[test(should_revert, selector = 0xd0404f85)]
fn reclaim_inside_the_capture_window_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Reclaim { id },
    )
}

// cast sig "Expired()"
#[test(should_revert, selector = 0x203d82d8)]
fn charge_after_the_capture_window_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: 0)
    charge(w, id, amount: 1)
}

// cast sig "ExceedsHeld()"
#[test(should_revert, selector = 0x4d0b7d02)]
fn charge_above_the_held_amount_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    charge(w, id, amount: 70)
    charge(w, id, amount: 31)
}

// cast sig "AlreadyOpen()"
#[test(should_revert, selector = 0x965f8d94)]
fn opening_the_same_authorization_twice_reverts() uses (evm: mut Evm) {
    let w = world()
    let _ = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    let _ = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
}

// The wallet signed for 50, the merchant asks for 100.
// cast sig "BadSignature()"
#[test(should_revert, selector = 0x5cd5d233)]
fn opening_with_changed_terms_reverts() uses (evm: mut Evm) {
    let w = world()
    let _ = open(w, signed_limit: 50, limit: LIMIT, capture_by: NEVER)
}

// cast sig "NotMerchant()"
#[test(should_revert, selector = 0x3b6405f4)]
fn stranger_cannot_charge() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    let stranger = evm.create2<Stranger>(value: Wei::zero(), args: (), salt: 0)
    evm.call(
        addr: stranger,
        gas: GAS,
        value: Wei::zero(),
        message: StrangerMsg::Charge { tab: w.tab, id, amount: 1 },
    )
}

// cast sig "ExceedsCharged()"
#[test(should_revert, selector = 0xaddddaa3)]
fn refund_above_the_charged_amount_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, signed_limit: LIMIT, limit: LIMIT, capture_by: NEVER)
    charge(w, id, amount: 10)
    evm.call(
        addr: w.tab,
        gas: GAS,
        value: Wei::zero(),
        message: TabMsg::Refund { id, amount: 11 },
    )
}

// Anvil account 0 signs the typed data below with
// `cast wallet sign --data`; the hashes come from `cast keccak` over
// `cast abi-encode`, independent of this implementation.
//
//   domain:  Tab, version 1, chain 31337, verifying contract 0xdddd...dddd
//   message: payer anvil 0, merchant anvil 1, token 0xcccc...cccc,
//            limit 100, openBy 2000000000, captureBy 2000003600, nonce 1
const PAYER: u256 = 0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
const STRUCT_HASH: u256 = 0xa95e22e4e94ede262846c68139cbfc0b92146ccc51635cadd9d816223f0b0047
const DIGEST: u256 = 0x6a28aa36cd2f9d081439beb4bfc588be774d515b530349f9d28bb928a2219d38
const SIG_R: u256 = 0x53941482bff2d9088cc19021b6be44787bd817ee856422b470fb5c44f9e4a192
const SIG_S: u256 = 0x46aea031820deb48dde96a5b98a63482c5139a54d019e2e1d9105aef7d679f54

#[test]
fn authorization_matches_wallet_typed_data() {
    let struct_hash = authorization_hash(
        payer: Address::new(PAYER),
        merchant: Address::new(0x70997970c51812dc3a010c7d01b50e0d17dc79c8),
        token: Address::new(0xcccccccccccccccccccccccccccccccccccccccc),
        limit: 100,
        open_by: Timestamp::from_seconds(2000000000),
        capture_by: Timestamp::from_seconds(2000003600),
        nonce: 1,
    )
    assert!(struct_hash == STRUCT_HASH)

    let digest = eip712::digest(
        domain_separator: eip712::domain_separator(
            name_hash: NAME_HASH,
            version_hash: VERSION_HASH,
            chain_id: 31337,
            verifying_contract: Address::new(0xdddddddddddddddddddddddddddddddddddddddd),
        ),
        struct_hash,
    )
    assert!(digest == DIGEST)

    let sig = MemBuffer::new(65)
    unsafe {
        store_word(ptr: sig.ptr(), value: SIG_R)
        store_word(ptr: ptr::offset_bytes(sig.ptr(), 32), value: SIG_S)
        *ptr::offset_bytes(sig.ptr(), 64) = 27
    }
    match signature::recover(digest, sig.span()) {
        Option::Some(signer) => assert!(signer.word() == PAYER),
        Option::None => assert!(false),
    }
}
